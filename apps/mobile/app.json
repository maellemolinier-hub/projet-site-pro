{
  "expo": {
    "name": "Cap Entreprendre France",
    "slug": "cap-entreprendre-france",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a6b"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.cap-entreprendre-france.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cap Entreprendre France utilise votre position pour afficher les prix immobiliers autour de vous.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Cap Entreprendre France utilise votre position pour la prospection terrain en arrêt-plan.",
        "NSCameraUsageDescription": "Cap Entreprendre France utilise votre caméra pour scanner des QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a3a6b"
      },
      "package": "fr.cap-entreprendre-france.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Cap Entreprendre France à accéder à votre caméra."
        }
      ]
    ],
    "scheme": "cap-entreprendre-france",
    "extra": {
      "apiUrl": "http://localhost:8000",
      "webUrl": "http://localhost:3000",
      "eas": {
        "projectId": "cap-entreprendre-france-app"
      }
    }
  }
}