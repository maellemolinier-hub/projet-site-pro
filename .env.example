# ─── BASE DE DONNÉES (Supabase — gratuit) ────────────────────────────────────
# Créer un projet sur https://supabase.com → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── NEXTAUTH (zéro dépendance externe) ──────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="remplacer-par-une-cle-aleatoire-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ─── GOOGLE OAUTH (optionnel — gratuit) ──────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0
# Laisser vide pour désactiver le bouton Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── STRIPE (gratuit jusqu'au premier paiement réel) ─────────────────────────
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Créer les produits dans Stripe Dashboard puis coller les price_xxx ici
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_ANNUAL="price_..."
STRIPE_PRICE_EXPERT_MONTHLY="price_..."
STRIPE_PRICE_EXPERT_ANNUAL="price_..."
STRIPE_PRICE_AGENCE_MONTHLY="price_..."
STRIPE_PRICE_AGENCE_ANNUAL="price_..."

# ─── API INTERNE ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:8000"
API_SECRET="remplacer-par-secret-aleatoire"

# ─── REDIS (Upstash — gratuit) ───────────────────────────────────────────────
# https://upstash.com → Create database → REST URL
REDIS_URL="redis://localhost:6379"

# ─── MUX VIDÉO (formation — gratuit en dev) ───────────────────────────────────
# https://dashboard.mux.com → Settings → API Access Tokens
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# ─── CRON & ADMIN SECRETS ────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
CRON_SECRET="remplacer-par-secret-cron"
ADMIN_SECRET="remplacer-par-secret-admin"

# ─── DÉPLOIEMENT ─────────────────────────────────────────────────────────────
# Vercel (remplis via vercel env pull ou le dashboard Vercel)
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# Railway (remplis via railway login)
RAILWAY_TOKEN=""

# ─── MOBILE APP ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:8000"
EXPO_PUBLIC_WEB_URL="http://localhost:3000"

# ─── ASSISTANT DE PROSPECTION SMS (automation/sms_prospection) ───────────────
# Voir automation/sms_prospection/README.md pour la procédure complète.
COMPANY_NAME="Votre Entreprise"
SMS_SENDER_ID="PackDigital"
SMS_PROVIDER="brevo"                 # brevo | twilio
BREVO_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Base dédiée à la prospection SMS (par défaut : SQLite local si absent)
SMS_PROSPECTION_DATABASE_URL=""

# Google Agenda (compte de service — cf. README pour la configuration)
GOOGLE_CALENDAR_ID="primary"
GOOGLE_SERVICE_ACCOUNT_FILE="service-account.json"
BOOKING_BASE_URL="http://localhost:8010/reserver"
BOOKING_SLOT_DURATION_MINUTES="30"
BOOKING_LOOKAHEAD_DAYS="10"
BOOKING_TIMEZONE="Europe/Paris"

# Campagne
CAMPAIGN_DAILY_QUOTA="200"
SECONDS_BETWEEN_SMS="2"
CAMPAIGN_DRY_RUN="false"

# Secret partagé pour sécuriser les webhooks entrants (Make -> ce serveur)
SMS_WEBHOOK_SECRET="remplacer-par-secret-aleatoire"
