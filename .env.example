# ─── BASE DE DONNÉES (Supabase — gratuit) ────────────────────────────────────
# Créer un projet sur https://supabase.com → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── NEXTAUTH (zéro dépendance externe) ──────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="remplacer-par-une-cle-aleatoire-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ─── GOOGLE OAUTH (optionnel — gratuit) ──────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0
# Laisser vide pour désactiver le bouton Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── STRIPE (gratuit jusqu'au premier paiement réel) ─────────────────────────
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Créer les produits dans Stripe Dashboard puis coller les price_xxx ici
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_STARTER_ANNUAL="price_..."
STRIPE_PRICE_EXPERT_MONTHLY="price_..."
STRIPE_PRICE_EXPERT_ANNUAL="price_..."
STRIPE_PRICE_AGENCE_MONTHLY="price_..."
STRIPE_PRICE_AGENCE_ANNUAL="price_..."

# ─── API INTERNE ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:8000"
API_SECRET="remplacer-par-secret-aleatoire"

# ─── REDIS (Upstash — gratuit) ───────────────────────────────────────────────
# https://upstash.com → Create database → REST URL
REDIS_URL="redis://localhost:6379"

# ─── MUX VIDÉO (formation — gratuit en dev) ───────────────────────────────────
# https://dashboard.mux.com → Settings → API Access Tokens
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# ─── CRON & ADMIN SECRETS ────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
CRON_SECRET="remplacer-par-secret-cron"
ADMIN_SECRET="remplacer-par-secret-admin"

# ─── DÉPLOIEMENT ─────────────────────────────────────────────────────────────
# Vercel (remplis via vercel env pull ou le dashboard Vercel)
VERCEL_TOKEN=""
VERCEL_ORG_ID=""
VERCEL_PROJECT_ID=""

# Railway (remplis via railway login)
RAILWAY_TOKEN=""

# ─── MOBILE APP ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:8000"
EXPO_PUBLIC_WEB_URL="http://localhost:3000"

# ─── AGENTS IA — CAP ENTREPRENDRE FRANCE ─────────────────────────────────────
# Sans aucune clé ci-dessous, la plateforme tourne en MODE DÉMO (plan + prompts,
# sans appel LLM). Ajoutez au moins une clé pour obtenir de vrais livrables.

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Gemini (Google AI Studio) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# Fournisseur par défaut : anthropic | gemini | dryrun (auto-détecté sinon)
AGENTS_DEFAULT_PROVIDER=""
AGENTS_MAX_TOKENS="4096"

# Make (ex-Integromat) — https://www.make.com
# Webhook SORTANT : reçoit les livrables (écriture Google Sheets, email, Slack…)
MAKE_WEBHOOK_URL=""
# Secret partagé qui sécurise le webhook ENTRANT (/api/agents/webhook/make),
# à envoyer par Make dans l'en-tête x-cef-signature
MAKE_SIGNING_SECRET=""

# Google Sheets direct (optionnel — sinon passer par Make)
# JSON du compte de service (brut ou encodé base64) + ID du classeur
# (ex: le classeur "Cap Entreprendre France - Cerveau Central")
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SHEETS_ID=""

# HubSpot CRM — https://developers.hubspot.com (Private App token)
HUBSPOT_ACCESS_TOKEN=""

# Assistant vocal (prise de RDV & qualification) — vapi | retell
VOICE_PROVIDER="vapi"
VOICE_API_KEY=""
VOICE_PHONE_NUMBER_ID=""
VOICE_ASSISTANT_ID=""
