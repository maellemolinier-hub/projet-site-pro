# Clé API Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Session Bitwarden active (obtenue via `bw unlock` puis `bw unlock --raw`)
# Requis pour le tool de connexion aux comptes en ligne. Jamais commit ce fichier une fois rempli.
BW_SESSION=

# Dossier par defaut a ranger quand l'utilisateur dit "range mes photos"
DEFAULT_PHOTOS_DIR=

# Identifiants OAuth Gmail (Google Cloud Console > Identifiants > "Application de bureau")
# Voir README > Connecteur mail pour la procedure complete.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Serveur local pour l'app mobile en Wi-Fi (voir README > App mobile)
# Genere un token au hasard, ex: `openssl rand -hex 32`. Ne le partage avec personne.
ASSISTANT_TOKEN=
PORT=4174

# Pont mail entre le telephone et le PC (voir README > Pont mail)
# Seuls les mails envoyes DEPUIS cette adresse sont pris en compte.
TRUSTED_SENDER_EMAIL=
# Phrase secrete a inclure dans chaque commande envoyee par mail. Choisis une
# valeur longue et unique, ex: `openssl rand -hex 8`. Ne la partage avec personne.
COMMAND_PASSPHRASE=
# Frequence de verification des nouveaux mails, en millisecondes (30s par defaut)
MAIL_BRIDGE_INTERVAL_MS=30000

# Code secret a fournir pour confirmer une commande shell potentiellement
# destructrice (voir README > Choix de securite). Le mot CONFIRME seul ne
# suffit plus - il faut "CONFIRME <ce code>". Genere une valeur longue et
# unique, ex: `openssl rand -hex 8`. Ne la partage avec personne. Sans cette
# variable, aucune commande destructrice ne peut jamais etre confirmee.
CONFIRMATION_CODE=
